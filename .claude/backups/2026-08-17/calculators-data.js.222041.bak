        : 10 * weightKg + 6.25 * heightCm - 5 * v.age - 161;
      return {
        primary: { label: "BMR (calories/day at rest)", value: round(bmr, 0) },
        secondary: [{ l: "Formula used", v: "Mifflin-St Jeor" }],
